/* 参芪山房 全局基调
   色板：宣纸白 / 松烟墨 / 苍绿 / 赭金（点缀） */
page {
  background: #F6F2E9 url(data:image/jpeg;base64,) repeat;
  background-size: 250px 250px;
  color: #2B2F2A;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

@font-face {
  font-family: 'SQSerif';
  src: url(data:font/woff;base64,) format('woff');
  font-display: swap;
}
@font-face {
  font-family: 'SQCalli';
  src: url(data:font/woff;base64,) format('woff');
  font-display: swap;
}
/* 标题字体：品牌字体子集优先（真机加载），桌面字体兜底 */
.font-serif {
  font-family: "SQSerif", "STZhongsong", "华文中宋", "Songti SC", "STSong", "SimSun", serif;
}

/* 毛笔字：品牌行楷子集优先 */
.brand-calli {
  font-family: "SQCalli", "STXingkai", "华文行楷", "Kaiti SC", "STKaiti", "KaiTi", "SQSerif", serif;
}

/* 题跋式竖排 */
.vertical-text {
  writing-mode: vertical-rl;
  letter-spacing: 6rpx;
}


/* 通栏节标题：栏名 + 细分隔线 */
.section-head {
  display: flex;
  align-items: baseline;
  padding: 88rpx 48rpx 28rpx;
}
.section-title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}
.section-note {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #8A8F85;
  letter-spacing: 2rpx;
}
.section-line {
  margin: 0 48rpx;
  height: 1rpx;
  background: linear-gradient(to right, #C8A15E 0%, rgba(200, 161, 94, 0) 60%);
}
