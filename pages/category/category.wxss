.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ═══ 导航栏 ═══ */
.navbar {
  background: #F6F2E9;
}
.navbar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar-title {
  font-size: 32rpx;
  letter-spacing: 6rpx;
  color: #2B2F2A;
}

/* ═══ 场景 Tab ═══ */
.tabs {
  display: flex;
  background: #F6F2E9;
  border-bottom: 1rpx solid rgba(43, 47, 42, 0.08);
}
.tab {
  flex: 1;
  padding: 24rpx 0 20rpx;
  text-align: center;
}
.tab-name {
  font-size: 30rpx;
  color: #6E736A;
  letter-spacing: 3rpx;
}
.tab-sub {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #9A9E93;
  letter-spacing: 1rpx;
}
.tab-on .tab-name { color: #3F4E3F; }
.tab-on .tab-sub { color: #C8A15E; }
/* 选中态：名下一截金线 */
.tab-on {
  position: relative;
}
.tab-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 32rpx;
  height: 2rpx;
  background: #C8A15E;
}

/* ═══ 内容区 ═══ */
.swiper {
  flex: 1;
  width: 100%;
  height: 0;
}
.scroll {
  height: 100%;
  box-sizing: border-box;
}

/* 系列页头图 */
.scene-banner {
  display: block;
  margin: 36rpx 48rpx 0;
  width: 654rpx;
  height: 250rpx;
  border-radius: 6rpx;
}

/* 系列页头 */
.scene-head {
  display: flex;
  margin: 48rpx 48rpx 10rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(43, 47, 42, 0.08);
}
.scene-rail {
  width: 6rpx;
  align-self: stretch;
  margin-right: 28rpx;
  border-radius: 3rpx;
}
.scene-big {
  font-size: 80rpx;
  letter-spacing: 10rpx;
  line-height: 1.2;
}
.scene-full {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A8F85;
  letter-spacing: 3rpx;
}
.scene-note {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #4A4F48;
  letter-spacing: 1rpx;
}
.scene-head-quote {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-end;
  text-align: right;
}
.scene-quote {
  font-size: 24rpx;
  color: #6E736A;
  line-height: 1.8;
  max-width: 260rpx;
}
.scene-quote-from {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9A9E93;
  letter-spacing: 1rpx;
}

/* 产品卡 */
.product {
  display: flex;
  align-items: center;
  margin: 28rpx 48rpx 0;
  padding: 26rpx;
  background: #FCFAF3;
  border: 1rpx solid rgba(43, 47, 42, 0.12);
  border-radius: 8rpx;
}
.product-rail {
  width: 4rpx;
  height: 88rpx;
  border-radius: 2rpx;
  margin-right: 22rpx;
}
.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 6rpx;
  background: #F3EFE4;
  overflow: hidden;
  flex-shrink: 0;
}
.product-img-img {
  width: 120rpx;
  height: 120rpx;
  display: block;
}
.product-body {
  flex: 1;
  margin-left: 26rpx;
}
.product-name {
  font-size: 32rpx;
  letter-spacing: 2rpx;
}
.product-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6E736A;
}
.product-spec {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #9A9E93;
  letter-spacing: 1rpx;
}
.product-arrow {
  margin-left: 20rpx;
  color: #C8A15E;
  font-size: 28rpx;
}

.scene-foot {
  position: relative;
  margin-top: 56rpx;
  padding: 90rpx 0 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A8F85;
  letter-spacing: 4rpx;
}
