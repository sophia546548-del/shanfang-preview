.page {
  min-height: 100vh;
  background: #F6F2E9;
}

.navbar { background: #F6F2E9; }
.navbar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar-title {
  font-size: 32rpx;
  letter-spacing: 6rpx;
}

.gift-head {
  padding: 60rpx 48rpx 44rpx;
  border-bottom: 1rpx solid rgba(43, 47, 42, 0.08);
}
.gift-quote {
  font-size: 34rpx;
  color: #4A4F48;
  letter-spacing: 2rpx;
}
.gift-quote-from {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9A9E93;
}
.gift-note {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #6E736A;
  letter-spacing: 2rpx;
}

/* 礼盒卡：深底，右竖排大字 */
.card {
  position: relative;
  margin: 44rpx 48rpx 0;
  height: 260rpx;
  border-radius: 6rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
}
.card-mask { position: absolute; inset: 0; }
.card-word {
  position: absolute;
  right: 40rpx;
  top: 36rpx;
  font-size: 44rpx;
  color: rgba(246, 242, 233, 0.9);
  letter-spacing: 10rpx;
}
.card-body {
  position: relative;
  padding-left: 40rpx;
  max-width: 460rpx;
}
.card-name {
  font-size: 36rpx;
  color: #F2EEE3;
  letter-spacing: 3rpx;
}
.card-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(246, 242, 233, 0.78);
}
.card-spec {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(246, 242, 233, 0.55);
  letter-spacing: 1rpx;
}
.card-arrow {
  position: absolute;
  right: 100rpx;
  bottom: 28rpx;
  color: rgba(246, 242, 233, 0.7);
  font-size: 28rpx;
}

.foot {
  position: relative;
  margin-top: 40rpx;
  padding: 110rpx 0 70rpx;
  text-align: center;
}
.foot-promise {
  position: relative;
  font-size: 24rpx;
  color: #6E736A;
  letter-spacing: 5rpx;
}
